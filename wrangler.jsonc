{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaleidoscope",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/og/*", "/p/*", "/sitemap.xml"]
  },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "kaleidoscope.ponderance.dev", "custom_domain": true }],
  "vars": {
    "PUBLIC_BASE_URL": "https://kaleidoscope.ponderance.dev",
    "GOOGLE_REDIRECT_URI": "https://kaleidoscope.ponderance.dev/api/auth/callback",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADsdEltLI2PUUeiE",
    "APPLE_BUNDLE_ID": "dev.ponderance.kaleidoscope",

    // Plus + free public-post cap. These live here and NOT in the dashboard:
    // `wrangler deploy` replaces the worker's var set wholesale, so a var added
    // through the dashboard is gone the next time we ship.
    //
    // Written as STRINGS on purpose. `vars` preserves JSON types, so `false`
    // here would arrive as a boolean and `PLUS_ENABLED === "true"` would fail
    // silently against it. src/worker/lib/validate.ts does the coercion.
    //
    // PLUS_ENABLED stays "false" until the IAP is approved. While it is false no
    // cap is enforced anywhere — a cap with no way to pay to lift it is just a
    // broken product. CAP_EPOCH is set to the real timestamp in the SAME deploy
    // that flips the flag; the placeholder below is already a valid integer
    // because the parse fails CLOSED (NaN → 500), so a non-integer placeholder
    // would take saves down the moment the flag flipped.
    "CAP_EPOCH": "0",
    "FREE_PUBLIC_CAP": "10",
    "FREE_LAYER_CAP": "3",
    "PLUS_LAYER_CAP": "8",
    "PLUS_ENABLED": "false",
    "PLUS_ALLOW_SANDBOX": "false",
    "PLUS_ALLOW_TEST": "false",
    "PLUS_PRODUCT_ID": "dev.ponderance.kaleidoscope.plus",
    // Lemon Squeezy. Empty until the store leaves test mode: LS pins a new store
    // to test mode until it approves the application, and test-mode products,
    // webhooks and API keys are a separate dataset whose ids do NOT carry over
    // to live. Fill these from the LIVE product, not the test one.
    //   LS_STORE_ID    store slug / subdomain          ("kaleidoscope-plus")
    //   LS_CHECKOUT_ID UUID from the Share modal        -> the checkout URL
    //   LS_VARIANT_ID  numeric variant id from the API  -> the webhook check
    "LS_STORE_ID": "",
    "LS_CHECKOUT_ID": "",
    "LS_VARIANT_ID": ""
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "kaleidoscope", "database_id": "eaf8e82a-2a74-40b0-a70c-e7144ff1e339" }
  ],
  "r2_buckets": [{ "binding": "ART", "bucket_name": "kaleidoscope-art" }],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "b26e47e5f0364eceb83edaf7ddcc5d84" },
    { "binding": "OAUTH", "id": "05e08ac3e45e415cb314da70bfbe60a5" },
    { "binding": "RATELIMIT", "id": "f33fc50443a0445c8f0a1afe73214969" },
    { "binding": "JWKS", "id": "52139b21c8e64a0a945bef2fefce373d" }
  ]
  // TURNSTILE_SITE_KEY is the real widget for kaleidoscope.ponderance.dev;
  // the matching TURNSTILE_SECRET_KEY is a Wrangler secret.
  // LS_WEBHOOK_SECRET and LS_API_KEY are Wrangler secrets too (T02d).
}
