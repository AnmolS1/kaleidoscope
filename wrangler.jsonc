{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaleidoscope",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/og/*"]
  },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "kaleidoscope.ponderance.dev", "custom_domain": true }],
  "vars": {
    "PUBLIC_BASE_URL": "https://kaleidoscope.ponderance.dev",
    "GOOGLE_REDIRECT_URI": "https://kaleidoscope.ponderance.dev/api/auth/callback",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "kaleidoscope", "database_id": "eaf8e82a-2a74-40b0-a70c-e7144ff1e339" }
  ],
  "r2_buckets": [{ "binding": "ART", "bucket_name": "kaleidoscope-art" }],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "b26e47e5f0364eceb83edaf7ddcc5d84" },
    { "binding": "OAUTH", "id": "05e08ac3e45e415cb314da70bfbe60a5" },
    { "binding": "RATELIMIT", "id": "f33fc50443a0445c8f0a1afe73214969" },
    { "binding": "JWKS", "id": "52139b21c8e64a0a945bef2fefce373d" }
  ]
  // TURNSTILE_SITE_KEY above is the Cloudflare test key until a real widget is
  // provisioned (Phase 4 / turnstile-spin).
}
