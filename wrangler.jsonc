{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaleidoscope",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/og/*", "/p/*", "/sitemap.xml"]
  },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "kaleidoscope.ponderance.dev", "custom_domain": true }],

  // OFF, stated rather than inherited. A preview URL is
  // `<version>-kaleidoscope.<subdomain>.workers.dev`, and it runs THIS Worker
  // against the REAL D1 and R2 — there is no preview environment here, the
  // bindings are the production ones. So every deployed version would answer on
  // a second hostname that nothing about `routes` protects, which is the same
  // shape as the estate note that Cloudflare Access binds a hostname and not a
  // Worker. Left to the platform default it is a security property nobody
  // decided and no diff would ever show changing.
  //
  // `workers_dev` is separately off as a CONSEQUENCE of declaring `routes`,
  // which is implicit in the same way; it is left alone here because turning it
  // off explicitly on a release deploy is a change with no test behind it.
  "preview_urls": false,
  "vars": {
    "PUBLIC_BASE_URL": "https://kaleidoscope.ponderance.dev",
    "GOOGLE_REDIRECT_URI": "https://kaleidoscope.ponderance.dev/api/auth/callback",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADsdEltLI2PUUeiE",
    "APPLE_BUNDLE_ID": "dev.ponderance.kaleidoscope",

    // Plus + free public-post cap. These live here and NOT in the dashboard:
    // `wrangler deploy` replaces the worker's var set wholesale, so a var added
    // through the dashboard is gone the next time we ship.
    //
    // Written as STRINGS on purpose. `vars` preserves JSON types, so `false`
    // here would arrive as a boolean and `PLUS_ENABLED === "true"` would fail
    // silently against it. src/worker/lib/validate.ts does the coercion.
    //
    // PLUS_ENABLED stays "false" until the IAP is approved. While it is false no
    // cap is enforced anywhere — a cap with no way to pay to lift it is just a
    // broken product. CAP_EPOCH is set to the real timestamp in the SAME deploy
    // that flips the flag; the placeholder below is already a valid integer
    // because the parse fails CLOSED (NaN → 500), so a non-integer placeholder
    // would take saves down the moment the flag flipped.
    //
    // 🔴 The placeholder is FAR FUTURE (2100-01-01), not 0.
    //
    // `0` parses fine, so it is the one value that defeats the fail-closed
    // reasoning above: `capPolicy` returns {enforced:true, cap:10, epoch:0} and
    // migration 0004 backfilled `published_at = created_at` for every existing
    // public row — so the instant the flag flips, every user with ten public
    // pieces is retroactively over cap, new public saves land unlisted, and
    // PATCH → public 402s. A far-future epoch fails the other way: nothing
    // counts yet, which is recoverable and invisible instead of a support
    // incident. `capEpochShipsWithFlag` in test/worker/config.test.ts refuses a
    // deploy where PLUS_ENABLED is true and this is still the placeholder.
    "CAP_EPOCH": "4102444800000",
    "FREE_PUBLIC_CAP": "10",
    "FREE_LAYER_CAP": "3",
    "PLUS_LAYER_CAP": "8",
    // TWO FLAGS, deliberately. PLUS_ENABLED governs ENFORCEMENT (the layer cap
    // and the public-wall cap). PLUS_SURFACE_ENABLED governs whether the Plus
    // UI — paywall, Restore, upsell — is VISIBLE at all.
    //
    // They were one flag, and that made the app unreviewable: with it false,
    // App Review opens the app and finds no Plus row, no paywall, no Restore
    // and no product, which is a Guideline 2.1 rejection of the binary as well
    // as the IAP. Turning the single flag on instead would have imposed the web
    // cap while Lemon Squeezy still had nothing to sell.
    //
    // So the review deploy runs SURFACE=true, ENABLED=false: the purchase is
    // findable and buyable, and nobody loses a layer or a public slot until the
    // caps are deliberately switched on with a real CAP_EPOCH.
    "PLUS_ENABLED": "false",
    "PLUS_SURFACE_ENABLED": "true",
    "PLUS_ALLOW_SANDBOX": "true",
    "PLUS_ALLOW_TEST": "false",
    "PLUS_PRODUCT_ID": "dev.ponderance.kaleidoscope.plus",
    // Lemon Squeezy. Empty until the store leaves test mode: LS pins a new store
    // to test mode until it approves the application, and test-mode products,
    // webhooks and API keys are a separate dataset whose ids do NOT carry over
    // to live. Fill these from the LIVE product, not the test one.
    //   LS_STORE_ID    store slug / subdomain          ("kaleidoscope-plus")
    //   LS_CHECKOUT_ID UUID from the Share modal        -> the checkout URL
    //   LS_VARIANT_ID  numeric variant id from the API  -> the webhook check
    "LS_STORE_ID": "",
    "LS_CHECKOUT_ID": "",
    "LS_VARIANT_ID": ""
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "kaleidoscope", "database_id": "eaf8e82a-2a74-40b0-a70c-e7144ff1e339" }
  ],
  "r2_buckets": [{ "binding": "ART", "bucket_name": "kaleidoscope-art" }],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "b26e47e5f0364eceb83edaf7ddcc5d84" },
    { "binding": "OAUTH", "id": "05e08ac3e45e415cb314da70bfbe60a5" },
    { "binding": "RATELIMIT", "id": "f33fc50443a0445c8f0a1afe73214969" },
    { "binding": "JWKS", "id": "52139b21c8e64a0a945bef2fefce373d" }
  ]
  // TURNSTILE_SITE_KEY is the real widget for kaleidoscope.ponderance.dev;
  // the matching TURNSTILE_SECRET_KEY is a Wrangler secret.
  // LS_WEBHOOK_SECRET and LS_API_KEY are Wrangler secrets too (T02d).
}
