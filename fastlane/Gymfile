# gym (build_app) configuration for the `beta` lane, kept declarative here.
#
# The .xcodeproj is GENERATED by XcodeGen from ios/project.yml and gitignored,
# so the beta lane runs `xcodegen generate` first. The Kaleidoscope scheme's
# archive builds the RandomWidget extension as a dependency and embeds it.
# Signing comes from match — see the beta lane in Fastfile.
project("ios/Kaleidoscope.xcodeproj")
scheme("Kaleidoscope")
configuration("Release")
destination("generic/platform=iOS")
export_method("app-store")
clean(true)
# /build is gitignored at the repo root.
output_directory("build")
output_name("Kaleidoscope")
