{
  "name": "kaleidoscope",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A modern kaleidoscope drawing toy — draw mandalas, save to a gallery, share & remix.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy -c dist/kaleidoscope/wrangler.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "db:migrate": "wrangler d1 migrations apply kaleidoscope --remote",
    "db:migrate:local": "wrangler d1 migrations apply kaleidoscope --local"
  },
  "dependencies": {
    "@preact/signals": "^2.9.2",
    "hono": "^4.12.27",
    "jose": "^6.2.3",
    "nanoid": "^5.1.16",
    "preact": "^10.29.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.3",
    "@cloudflare/workers-types": "^4.20260628.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@preact/preset-vite": "^2.10.5",
    "@types/node": "^26.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
