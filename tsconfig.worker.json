{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    // node types cover the worker tests' use of node:sqlite / node:fs / node:crypto
    // and import.meta.url. The worker runtime has nodejs_compat enabled, so node
    // builtins are legitimately available at runtime too.
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/worker", "test/worker"]
}
